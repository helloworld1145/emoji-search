<?xml version="1.0" encoding="utf-8"?><!--
  悬浮窗表情面板：整体高度锁定为「头部 + 1.5 行正方形图片」。
  高度推导：上下内边距 8+8 + 搜索框 36 + 6 + Tab 32 + 6 + 网格 150（= 1.5 × 单行 100dp）= 246dp。
  底部「分享」操作条以浮层形式盖在网格底部（FrameLayout bottom 对齐），不参与高度计算，
  因此面板高度恒定，不会因为选中表情而跳动。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="246dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/floating_panel_bg"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:hint="搜索表情 / 标签"
                android:background="@drawable/floating_edit_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageButton
                android:id="@+id/closeBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackground"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tabFav"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="收藏"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/floating_tab_selected" />

            <TextView
                android:id="@+id/tabRecent"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="最近"
                android:textSize="13sp"
                android:textColor="#AAAAAA"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="全部"
                android:textSize="13sp"
                android:textColor="#AAAAAA"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyTip"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="暂无表情，先去 App 收藏或扫描吧"
            android:textColor="#888888"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 选中表情后的操作条：浮层盖在网格底部，避免面板变高 -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/floating_action_bar_bg"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/actionPreview"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="#22000000" />

            <Button
                android:id="@+id/actionShare"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="分享"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/actionCancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackground"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
